# ZRAM compression algorithm configuration fragment
# The build.yml workflow appends this to defconfig when use_zram is enabled.
# CRYPTO_* options are required by the crypto-interface ZRAM implementation on 5.10–6.6.
# ZRAM_BACKEND_* options are required by the newer backend-based ZRAM implementation on 6.12.
# These symbols are declared only in Kconfig for 6.12+; build.yml removes them on older versions.
# (Bazel kernel_config validation requires every fragment option to exist in Kconfig.)
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_842=y
CONFIG_CRYPTO_LZ4K_OPLUS=y
CONFIG_ZRAM_BACKEND_LZ4K=y
CONFIG_ZRAM_BACKEND_LZ4KD=y
CONFIG_ZRAM_BACKEND_LZ4K_OPLUS=y
