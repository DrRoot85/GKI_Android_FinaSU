+name: GetManager
+permissions:
+  contents: write  # Allow writing to repository contents (for pushing tags)
+  actions: read   # Allows triggering actions
+
+on:
+  workflow_call: # This allows this workflow to be called from another workflow
+    inputs:
+      kernelsu_variant:
+        required: true
+        type: string
+      build_channel:
+        description: "Build channel: Release aligns with the official release; Latest (HEAD) follows the latest upstream commit"
+        required: false
+        type: string
+        default: "Release"
+      ksu_mode:
+        description: "KernelSU / SUSFS mode (the SUSFS module is downloaded when Off)"
+        required: false
+        type: string
+        default: "Off"
+      use_nomount:
+        description: "Enable the NoMount mount meta-module (the companion module is downloaded when enabled)"
+        required: false
+        type: boolean
+        default: false
+      use_zram:
+        required: false
+        type: boolean
+        default: false
+      use_bbg:
+        required: false
+        type: boolean
+        default: false
+      use_net_enhance:
+        required: false
+        type: boolean
+        default: false
+      use_rekernel:
+        required: false
+        type: boolean
+        default: false
+      use_kpm:
+        required: false
+        type: boolean
+        default: false
+      cve_2026_43499_patch:
+        required: false
+        type: boolean
+        default: false
+      skip_incompatible:
+        required: false
+        type: boolean
+        default: true
+      droidspaces:
+        description: "Droidspaces slot (off/678/123/345)"
+        required: false
+        type: string
+        default: "off"
+      droidspaces_ntsync:
+        required: false
+        type: boolean
+        default: false
+      artifact_upload_mode:
+        required: false
+        type: string
+        default: "AnyKernel3.zip only"
+      version:
+        description: "Custom kernel version name (leave empty = default)"
+        required: false
+        type: string
+        default: ""
+      build_time:
+        description: "Custom build time (leave empty = automatically use the current Beijing time)"
+        required: false
+        type: string
+        default: ""
+    outputs:
+      susVer:
+        description: "The fetched SUSFS version number"
+        value: ${{ jobs.get_ksu_manager.outputs.susVer }}
+
+      ksuVer:
+        description: "The calculated KSU version number"
+        value: ${{ jobs.get_ksu_manager.outputs.ksuVer }}
+
+      managerVer:
+        description: "Measured version number of the official Manager build"
+        value: ${{ jobs.get_ksu_manager.outputs.managerVer }}
+
+      ksuCommit:
+        description: "Commit SHA used for kernel-side alignment (Release channel = Release tag commit; Latest channel = the selected CI build commit or HEAD)"
+        value: ${{ jobs.get_ksu_manager.outputs.ksuCommit }}
+
+      channelTag:
+        description: "Release tag selected by the Release channel (empty for the Latest channel or on fallback)"
+        value: ${{ jobs.get_ksu_manager.outputs.channelTag }}
+
+      managerCertSize:
+        description: "FinaSU manager signing certificate DER size (0x hex, used to align the kernel's second trust slot)"
+        value: ${{ jobs.get_ksu_manager.outputs.managerCertSize }}
+
+      managerCertHash:
+        description: "FinaSU manager signing certificate SHA256 (used to align the kernel's second trust slot)"
+        value: ${{ jobs.get_ksu_manager.outputs.managerCertHash }}
+
+jobs:
+  get_ksu_manager:
+    runs-on: ubuntu-24.04
+    outputs:
+      # Output 1: KSU version number
+      ksuVer: ${{ steps.get_version.outputs.kversion }}
+      # Output 2: SUSFS version number
+      susVer: ${{ steps.get_version.outputs.sversion }}
+      # Output 3: Measured Manager version number
+      managerVer: ${{ steps.add_KSU.outputs.managerVer }}
+      # Output 4: Commit SHA used for kernel-side alignment (Release channel = Release tag commit; Latest channel = empty)
+      ksuCommit: ${{ steps.add_KSU.outputs.ksuCommit }}
+      # Output 5: Release tag selected by the Release channel
+      channelTag: ${{ steps.add_KSU.outputs.channelTag }}
+      # Output 6/7: FinaSU manager signing certificate (used to align the kernel's second trust slot)
+      managerCertSize: ${{ steps.add_KSU.outputs.managerCertSize }}
+      managerCertHash: ${{ steps.add_KSU.outputs.managerCertHash }}
+    env:
+      CCACHE_COMPILERCHECK: "%compiler% -dumpmachine; %compiler% -dumpversion"
+      CCACHE_NOHASHDIR: "true"
+      CCACHE_HARDLINK: "true"
+      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+
+    steps:
+      - name: Check out script repository
+        uses: actions/checkout@v7
+
+      - name: Install dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y git curl jq unzip
+
+      - name: Get KSU & SUSFS versions
+        id: get_version
+        if: inputs.ksu_mode != 'Disable KSU'
+        run: |
+
+          if [ "${{ inputs.kernelsu_variant }}" == "SukiSU-Nova" ]; then
+            echo "This is the SukiSU-Nova variant"
+            git clone https://github.com/SukiSU-Nova/SukiSU-Nova.git KernelSU
+          elif [ "${{ inputs.kernelsu_variant }}" == "BakaSU" ]; then
+            echo "This is the BakaSU variant"
+            git clone https://github.com/Baka-SU/BakaSU.git KernelSU
+          elif [ "${{ inputs.kernelsu_variant }}" == "FinaSU" ]; then
+            echo "This is the FinaSU variant"
+            git clone https://github.com/LyraVoid/FinaSU.git KernelSU
+          else
+            echo "Unknown variant"
+            exit 1
+          fi
+
+          cd KernelSU
+
+          # Compute the KSU version number
+          KSU_GIT_VERSION=$(git rev-list --count HEAD)
+
+          if [ "${{ inputs.kernelsu_variant }}" == "SukiSU-Nova" ]; then
+            KSU_VERSION=$((30000 + KSU_GIT_VERSION - 4001))
+          elif [ "${{ inputs.kernelsu_variant }}" == "FinaSU" ]; then
+            # Both the FinaSU kernel Kbuild and the manager build.gradle.kts compute the version as 30000 + git commit count
+            KSU_VERSION=$((30000 + KSU_GIT_VERSION))
+          else
+            KSU_VERSION=$((30700 + KSU_GIT_VERSION))
+          fi
+          echo $KSU_VERSION
+          echo "KSU_VERSION=$KSU_VERSION" >> $GITHUB_ENV
+
+          # Compute the SUSFS version number
+          INFO="https://gitlab.com/simonpunk/susfs4ksu/-/raw/gki-android14-6.1/ksu_module_susfs/module.prop"
+          SUS_VERSION=$(curl -s $INFO | awk -F '=' '$1 == "version" { print $2 }')
+          echo $SUS_VERSION
+
+          # Export these two values for the release
+          echo "kversion=$KSU_VERSION" >> $GITHUB_OUTPUT
+          echo "sversion=$SUS_VERSION" >> $GITHUB_OUTPUT
+
+      # ==================== Build channel ====================
+      # Release: the manager takes the official "stable" Release (prerelease=false, tag commit + that Release's APK);
+      #       when upstream has no stable Release (e.g. BakaSU only has rc pre-releases),
+      #       use the latest uploaded build of the official default branch instead, and the kernel is still pinned to that build commit
+      # Latest: the manager takes the latest build whose version matches the default branch HEAD (any branch), and the kernel is pinned to that HEAD;
+      #       BakaSU/FinaSU take the latest build of build-manager.yml directly, and the kernel is pinned to that build commit
+      - name: Select manager source (build channel)
+        id: channel
+        run: |
+
+          CHANNEL_RAW="${{ inputs.build_channel }}"
+          case "$CHANNEL_RAW" in
+            Latest*|latest*|HEAD*) CHANNEL_KIND="latest"; PIN_MODE="head" ;;
+            *)                   CHANNEL_KIND="release"; PIN_MODE="pin" ;;
+          esac
+          echo "Build channel: $CHANNEL_RAW -> $CHANNEL_KIND (pin_mode=$PIN_MODE)"
+
+          case "${{ inputs.kernelsu_variant }}" in
+            "SukiSU-Nova") REPO="SukiSU-Nova/SukiSU-Nova"; PREF="universal" ;;
+            "BakaSU") REPO="Baka-SU/BakaSU";           PREF="arm64" ;;
+            "FinaSU") REPO="LyraVoid/FinaSU";          PREF="universal" ;;
+            *) echo "::error::Unknown variant"; exit 1 ;;
+          esac
+
+          {
+            echo "CHANNEL_KIND=$CHANNEL_KIND"
+            echo "PIN_MODE=$PIN_MODE"
+            echo "MANAGER_REPO=$REPO"
+            echo "MANAGER_SOURCE=ci"
+          } >> "$GITHUB_ENV"
+
+          if [ "$CHANNEL_KIND" != "release" ]; then
+            echo "Latest channel: kernel pinned to the default branch HEAD; manager takes the latest build whose version matches HEAD"
+            exit 0
+          fi
+
+          # ---------- Release channel: resolve the official Release ----------
+          REL_JSON=""
+          for ATTEMPT in 1 2 3; do
+            REL_JSON=$(curl -s --fail --max-time 30 \
+              -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
+              -H "Accept: application/vnd.github+json" \
+              "https://api.github.com/repos/$REPO/releases?per_page=40") \
+              && [ -n "$REL_JSON" ] && break
+            echo "Failed to fetch the Release list of $REPO, retrying ($ATTEMPT/3)..."
+            REL_JSON=""
+            sleep 5
+          done
+
+          # Selection rules:
+          #   1) Skip drafts and rolling release tags (manager-ci / nightly / latest, etc., whose content is always the latest CI output)
+          #   2) Keep only Releases that carry an APK asset (excluding debug / spoofed packages)
+          #   3) Accept only stable releases (prerelease=false): pre-releases such as rc / beta belong to the "Latest" channel, and the Release channel does not take them
+          #   4) ABI preference: BakaSU takes arm64-v8a, the others prefer universal
+          PICK=""
+          if [ -n "$REL_JSON" ]; then
+            PICK=$(printf '%s' "$REL_JSON" | jq -r --arg pref "$PREF" '
+              [ .[] | select(.draft == false) ]
+              | map(. + { _ts: (.published_at // .created_at // "") })
+              | sort_by(._ts) | reverse
+              | map(. + {
+                  _rolling: (.tag_name | test("(?i)^(manager-ci|manager_ci|nightly|latest|ci)$")),
+                  _apks: [ .assets[]?
+                           | select(.name | test("\\.apk$"; "i"))
+                           | select(.name | test("(?i)debug|spoofed") | not) ]
+                })
+              | map(. + {
+                  _apks: (._apks | sort_by(
+                    if   (.name | test("(?i)" + $pref)) then 0
+                    elif (.name | test("(?i)universal")) then 1
+                    elif (.name | test("(?i)arm64")) then 2
+                    else 3 end))
+                })
+              | map(select((._rolling | not) and ((._apks | length) > 0)))
+              | map(select(.prerelease | not))
+              | .[0] as $p
+              | if $p then
+                  [ $p.tag_name, ( $p.prerelease | tostring ), $p._apks[0].name, $p._apks[0].browser_download_url ] | @tsv
+                else empty end
+            ')
+          fi
+
+          # In some repositories (e.g. just renamed/migrated) the Release list endpoint returns an empty array, while
+          # /releases/latest still works; the latest semantics is "the newest non-prerelease",
+          # so fall back to latest in that case, to avoid misjudging "has a stable release" as "has none" and falling through to a CI build
+          if [ -z "$PICK" ]; then
+            LATEST_JSON=""
+            for ATTEMPT in 1 2 3; do
+              LATEST_CODE=$(curl -s -o /tmp/rel_latest.json -w '%{http_code}' --max-time 30 \
+                -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
+                -H "Accept: application/vnd.github+json" \
+                "https://api.github.com/repos/$REPO/releases/latest") || LATEST_CODE=000
+              if [ "$LATEST_CODE" = "200" ]; then
+                LATEST_JSON=$(cat /tmp/rel_latest.json)
+                break
+              fi
+              if [ "$LATEST_CODE" = "404" ]; then
+                echo "$REPO has no latest Release (upstream only has pre-releases or none published)"
+                break
+              fi
+              echo "Failed to fetch the latest Release of $REPO (HTTP $LATEST_CODE), retrying ($ATTEMPT/3)..."
+              sleep 5
+            done
+            if [ -n "$LATEST_JSON" ]; then
+              PICK=$(printf '%s' "$LATEST_JSON" | jq -r --arg pref "$PREF" '
+                [ . ]
+                | map(select((.draft | not) and (.prerelease | not)))
+                | map(. + {
+                    _apks: [ .assets[]?
+                             | select(.name | test("\\.apk$"; "i"))
+                             | select(.name | test("(?i)debug|spoofed") | not) ]
+                  })
+                | map(. + {
+                    _apks: (._apks | sort_by(
+                      if   (.name | test("(?i)" + $pref)) then 0
+                      elif (.name | test("(?i)universal")) then 1
+                      elif (.name | test("(?i)arm64")) then 2
+                      else 3 end))
+                  })
+                | map(select((._apks | length) > 0))
+                | .[0] as $p
+                | if $p then
+                    [ $p.tag_name, ( $p.prerelease | tostring ), $p._apks[0].name, $p._apks[0].browser_download_url ] | @tsv
+                  else empty end
+              ')
+              if [ -n "$PICK" ]; then
+                echo "Release list is empty; using the latest endpoint instead: $PICK"
+              fi
+            fi
+          fi
+
+          if [ -z "$PICK" ]; then
+            echo "::notice::$REPO has no usable stable Release (only pre-releases or no APK attached); using the latest uploaded build of the official default branch (the kernel is still pinned to that commit)"
+            exit 0
+          fi
+
+          IFS=$'\t' read -r REL_TAG REL_PRE REL_APK_NAME REL_APK_URL <<< "$PICK"
+
+          # Resolve the commit for the Release tag (prefer the local clone, fall back to a remote query)
+          REL_COMMIT=$(git -C KernelSU rev-parse "${REL_TAG}^{commit}" 2>/dev/null || true)
+          if [ -z "$REL_COMMIT" ]; then
+            # An annotated tag must be dereferenced, otherwise you get the tag object instead of the commit
+            REL_COMMIT=$(git ls-remote "https://github.com/$REPO.git" "refs/tags/${REL_TAG}^{}" 2>/dev/null | awk '{print $1}')
+          fi
+          if [ -z "$REL_COMMIT" ]; then
+            REL_COMMIT=$(git ls-remote "https://github.com/$REPO.git" "refs/tags/${REL_TAG}" 2>/dev/null | awk '{print $1}')
+          fi
+          if [ -z "$REL_COMMIT" ]; then
+            echo "::warning title=Release channel fallback::Cannot resolve the commit for Release $REL_TAG; using the latest uploaded build of the official default branch instead"
+            exit 0
+          fi
+
+          {
+            echo "MANAGER_SOURCE=release"
+            echo "REL_TAG=$REL_TAG"
+            echo "REL_COMMIT=$REL_COMMIT"
+            echo "REL_APK_NAME=$REL_APK_NAME"
+            echo "REL_APK_URL=$REL_APK_URL"
+          } >> "$GITHUB_ENV"
+
+          if [ "$REL_PRE" = "true" ]; then
+            echo "::notice::Upstream has no stable release; using the latest pre-release $REL_TAG"
+          fi
+          echo "Release channel: Release $REL_TAG (${REL_COMMIT:0:8}), manager $REL_APK_NAME"
+
+      - name: Add KernelSU
+        id: add_KSU
+        if: inputs.ksu_mode != 'Disable KSU'
+        continue-on-error: true
+        run: |
+          VARIANT="${{ inputs.kernelsu_variant }}"
+
+          case "$VARIANT" in
+            "SukiSU-Nova") REPO="SukiSU-Nova/SukiSU-Nova"; KSUM="manager"; EXPECTED_BRANCH="main" ;;
+            "BakaSU") REPO="Baka-SU/BakaSU";           KSUM="manager"; EXPECTED_BRANCH="main" ;;
+            "FinaSU") REPO="LyraVoid/FinaSU";          KSUM="manager"; EXPECTED_BRANCH="master" ;;
+            *) echo "::error::Unknown variant: $VARIANT"; exit 1 ;;
+          esac
+
+          # Channel fallback resolution (so it can still be determined from the input if the selection step misbehaves)
+          CHANNEL_KIND="${CHANNEL_KIND:-}"
+          if [ -z "$CHANNEL_KIND" ]; then
+            case "${{ inputs.build_channel }}" in
+              Latest*|latest*|HEAD*) CHANNEL_KIND="latest" ;;
+              *)                   CHANNEL_KIND="release" ;;
+            esac
+          fi
+
+          mkdir -p manager-artifacts
+
+          # ==================== A. Release channel: official Release manager ====================
+          if [ "${MANAGER_SOURCE:-ci}" = "release" ] && [ -n "${REL_APK_URL:-}" ]; then
+            echo "Release channel: downloading the manager of Release $REL_TAG ($REL_APK_NAME)..."
+            REL_APK="manager-artifacts/$(basename "$REL_APK_NAME")"
+            if curl -sL --fail --retry 3 --max-time 300 -o "$REL_APK" "$REL_APK_URL"; then
+              # Strip the ABI segment before extracting the version, so numeric tails such as "_64" of x86_64 are not mistaken for the versionCode
+              CLEAN_NAME=$(basename "$REL_APK" | sed -E 's/-(arm64-v8a|armeabi-v7a|armv7|riscv64|x86_64|x86|universal)-release\.apk$/.apk/')
+              MANAGER_VERSION=$(echo "$CLEAN_NAME" | grep -oE '_[0-9]+' | tail -n 1 | tr -d '_')
+              if [[ "${MANAGER_VERSION:-}" =~ ^[0-9]+$ ]]; then
+                echo "Release manager version: $MANAGER_VERSION (tag $REL_TAG, commit ${REL_COMMIT:0:8})"
+                echo "MANAGER_VERSION=$MANAGER_VERSION" >> $GITHUB_ENV
+                {
+                  echo "managerVer=$MANAGER_VERSION"
+                  echo "ksuCommit=$REL_COMMIT"
+                  echo "channelTag=$REL_TAG"
+                } >> $GITHUB_OUTPUT
+
+                # Version consistency self-check: the KSU version of the Release tag commit should equal the manager versionCode
+                REL_COUNT=$(git -C KernelSU rev-list --count "$REL_COMMIT" 2>/dev/null || echo "")
+                if [ -n "$REL_COUNT" ]; then
+                  case "$VARIANT" in
+                    SukiSU-Nova) REL_KSU_VERSION=$((30000 + REL_COUNT - 4001)) ;;
+                    BakaSU) REL_KSU_VERSION=$((30700 + REL_COUNT)) ;;
+                    FinaSU) REL_KSU_VERSION=$((30000 + REL_COUNT)) ;;
+                  esac
+                  if [ "$MANAGER_VERSION" != "$REL_KSU_VERSION" ]; then
+                    echo "::warning::Release manager version $MANAGER_VERSION does not match the KSU version $REL_KSU_VERSION of the tag commit"
+                  fi
+                fi
+
+                if [ "$VARIANT" == "FinaSU" ]; then
+                  echo "Extracting the signing certificate from the Release manager APK..."
+                  CERT_INFO=$(python3 "$GITHUB_WORKSPACE/scripts/finasu_compat/extract_manager_cert.py" "$REL_APK" | head -n1)
+                  if [ -n "$CERT_INFO" ]; then
+                    CERT_SIZE=$(echo "$CERT_INFO" | awk '{print $1}')
+                    CERT_HASH=$(echo "$CERT_INFO" | awk '{print $2}')
+                    echo "managerCertSize=$CERT_SIZE" >> $GITHUB_OUTPUT
+                    echo "managerCertHash=$CERT_HASH" >> $GITHUB_OUTPUT
+                    echo "Release manager certificate size=$CERT_SIZE sha256=$CERT_HASH"
